# ES modules must be served as JavaScript or browsers refuse to load them
<IfModule mod_mime.c>
AddType application/javascript .mjs
</IfModule>
<FilesMatch "\.mjs$">
ForceType application/javascript
</FilesMatch>
<IfModule mod_rewrite.c>
Options -Indexes -MultiViews
RewriteEngine On
# One-time installer lives at a private address; the file itself cannot be requested directly.
RewriteRule ^setup/afsar/?$ install.php [L]
RewriteCond %{THE_REQUEST} \s/install\.php [NC]
RewriteRule ^install\.php$ - [R=404,L]
RewriteCond %{QUERY_STRING} (^|&)v=[a-f0-9]{12}(&|$)
RewriteRule \.(js|mjs|css)$ - [E=CVT_FINGERPRINTED:1]
# Ready-made public pages (Owner Console > Speed & traffic, or php artisan cvtara:prebuild): a visitor with no session cookie is served
# straight from disk. Signed-in visitors, queries and every other address go through the application as usual.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{QUERY_STRING} ^$
RewriteCond %{HTTP_COOKIE} !(^|;\s*)[A-Za-z0-9_-]*session=
RewriteCond %{DOCUMENT_ROOT}/_pages/.stamp -f
RewriteCond %{DOCUMENT_ROOT}/_pages/.disabled !-f
RewriteRule ^ - [E=CVT_PAGES:1]
RewriteCond %{ENV:CVT_PAGES} 1
RewriteCond %{DOCUMENT_ROOT}/_pages/index.html -f
RewriteRule ^$ _pages/index.html [L]
RewriteCond %{ENV:CVT_PAGES} 1
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{DOCUMENT_ROOT}/_pages/$1 -f
RewriteRule ^([a-z0-9][a-z0-9_.-]*\.html)$ _pages/$1 [L]
RewriteCond %{ENV:CVT_PAGES} 1
RewriteCond %{DOCUMENT_ROOT}/_pages/$1/index.html -f
RewriteRule ^((?:guides|calculators|resume-examples|resume-templates|cover-letter-examples|interview-questions|resume-builder|resume|resume-words|ats-checker)(?:/[a-z0-9/-]*[a-z0-9])?)/?$ _pages/$1/index.html [L]
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(css|js|mjs)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
<FilesMatch "\.(woff2|webp|png|jpg|jpeg|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
# Scripts and styles requested with a ?v=<fingerprint> change address whenever they change, so browsers may keep them for a year.
Header set Cache-Control "public, max-age=31536000, immutable" env=CVT_FINGERPRINTED
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain application/vnd.ms-excel
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>

<FilesMatch "\.(zip|env|sqlite|log)$">
Require all denied
</FilesMatch>

# Do not advertise the server stack
ServerSignature Off
<IfModule mod_headers.c>
Header always unset X-Powered-By
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>
# Owner area: never cached by shared proxies
<FilesMatch "^(admin|owner)[-.]">
Header set Cache-Control "private, no-store"
</FilesMatch>
